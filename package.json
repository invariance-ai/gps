{
  "name": "gps-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Codebase context for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/invariance-ai/gps.git"
  },
  "homepage": "https://github.com/invariance-ai/gps",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm -r --parallel dev",
    "bench:perf": "tsx bench/perf/run.ts",
    "bench:memory": "tsx bench/memory/run.ts",
    "bench:memory:plan": "tsx bench/memory/run.ts --plan-only --rules bench/memory/rules/ky",
    "bench:memory:test": "vitest run bench/memory",
    "perf:check": "tsx bench/perf/compare-thresholds.ts --baseline bench/baselines/perf-self.json --current bench/perf/results/current.json",
    "verify:check": "tsx bench/perf/compare-verify.ts --baseline bench/baselines/verify-index-self.json --current bench/perf/results/verify-current.json",
    "bench:compare": "tsx bench/perf/compare-all.ts",
    "bench:compare:self": "tsx bench/perf/compare-all.ts --corpus self --skip-cmm --skip-accuracy",
    "bench:compare:flask": "tsx bench/perf/compare-all.ts --corpus flask",
    "bench:compare:django": "tsx bench/perf/compare-all.ts --corpus django -n 8",
    "gen:docs": "tsx scripts/gen-commands-doc.ts",
    "gen:schemas": "tsx scripts/gen-json-schemas.ts",
    "gen:check": "pnpm gen:docs && pnpm gen:schemas && git diff --exit-code docs/guide/commands.md packages/schemas/json",
    "release": "tsx scripts/release.ts",
    "release:check": "tsx scripts/release.ts --check",
    "release:dry": "bash scripts/publish.sh --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.5.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  }
}
