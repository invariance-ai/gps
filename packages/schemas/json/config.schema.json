{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/invariance-ai/gps/schemas/config.schema.json",
  "title": "gps config",
  "$ref": "#/definitions/gps config",
  "definitions": {
    "gps config": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "typescript",
              "python",
              "javascript"
            ]
          },
          "default": [
            "typescript"
          ]
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "depth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3
        },
        "strands": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "structural",
              "tests",
              "provenance",
              "invariants"
            ]
          },
          "default": [
            "structural",
            "tests",
            "provenance",
            "invariants"
          ]
        },
        "capture": {
          "type": "string",
          "enum": [
            "inbox",
            "auto"
          ],
          "default": "auto"
        },
        "promote": {
          "type": "string",
          "enum": [
            "never",
            "safe",
            "all"
          ],
          "default": "never"
        },
        "auto_suggest": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "description": "gps repo configuration written to .gps/config.yml by `gps init`."
    }
  }
}
